# /etc/sudoers.d/forever-agent
# Lets the agent account run the sim wrappers without a password. Nothing here can reach prod.
# Every command is a root-owned wrapper under /usr/local/sbin/forever-agent that does one fixed job.
# Installed by install-agent-sudo.sh; remove with install-agent-sudo.sh --remove.
Cmnd_Alias FOREVER_SIM_CTL = \
    /usr/local/sbin/forever-agent/forever-sim-ctl start, \
    /usr/local/sbin/forever-agent/forever-sim-ctl stop, \
    /usr/local/sbin/forever-agent/forever-sim-ctl restart, \
    /usr/local/sbin/forever-agent/forever-sim-ctl reset-failed, \
    /usr/local/sbin/forever-agent/forever-sim-ctl status
Cmnd_Alias FOREVER_SIM_DEPLOY = \
    /usr/local/sbin/forever-agent/forever-sim-deploy conf, \
    /usr/local/sbin/forever-agent/forever-sim-deploy modules, \
    /usr/local/sbin/forever-agent/forever-sim-deploy binaries
Cmnd_Alias FOREVER_SIM_DB = \
    /usr/local/sbin/forever-agent/forever-sim-db backup, \
    /usr/local/sbin/forever-agent/forever-sim-db reset-world, \
    /usr/local/sbin/forever-agent/forever-sim-db reset-hotfixes, \
    /usr/local/sbin/forever-agent/forever-sim-db reset-characters
Cmnd_Alias FOREVER_SIM_LOGS = \
    /usr/local/sbin/forever-agent/forever-sim-logs export, \
    /usr/local/sbin/forever-agent/forever-sim-logs tail-server
# The profile wrapper only watches the sim worldserver (perf) and validates its one number.
Cmnd_Alias FOREVER_SIM_PROFILE = /usr/local/sbin/forever-agent/forever-sim-profile *
# The soak wrapper validates its own options (numbers only).
Cmnd_Alias FOREVER_SIM_SOAK = /usr/local/sbin/forever-agent/forever-sim-soak *

AGENT_USER ALL=(root) NOPASSWD: FOREVER_SIM_CTL, FOREVER_SIM_DEPLOY, FOREVER_SIM_DB, FOREVER_SIM_LOGS, FOREVER_SIM_SOAK, FOREVER_SIM_PROFILE
