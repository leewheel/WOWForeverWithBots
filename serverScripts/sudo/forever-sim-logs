#!/usr/bin/env bash
# forever-sim-logs <export|tail-server>
#   export       copies the sim's logs, bot telemetry and the live picture (bots-live.json) to /srv/forever/build/sim-logs, readable by the
#                calling user, so reports can be made without root.
#   tail-server  prints the last 300 lines of the sim's Server.log.
# Symlinks are never followed.
set -euo pipefail
PATH=/usr/sbin:/usr/bin:/sbin:/bin
umask 027

LOGS=/var/log/forever/sim
OUT=/srv/forever/build/sim-logs

case "${1:-}" in
  export)
    owner="${SUDO_USER:-}"
    [[ -n "$owner" && "$owner" != root ]] || { echo "run through sudo from your own account" >&2; exit 1; }
    install -d -o "$owner" -g forever-build -m 0750 "$OUT"
    n=0
    shopt -s nullglob
    for f in "$LOGS"/Server.log "$LOGS"/DBErrors.log "$LOGS"/GM.log "$LOGS"/scenario-results.log \
             "$LOGS"/forever-bots-telemetry.csv "$LOGS"/forever-bots-telemetry.csv.[0-9]* "$LOGS"/bots-live.json; do
      [[ -f "$f" && ! -L "$f" ]] || continue
      install -o "$owner" -g forever-build -m 0640 "$f" "$OUT/$(basename "$f")"
      n=$((n + 1))
    done
    echo "exported $n files to $OUT"
    ;;
  tail-server)
    f="$LOGS/Server.log"
    [[ -f "$f" && ! -L "$f" ]] || { echo "no $f" >&2; exit 1; }
    exec /usr/bin/tail -n 300 "$f"
    ;;
  *) echo "usage: forever-sim-logs export|tail-server" >&2; exit 2 ;;
esac
